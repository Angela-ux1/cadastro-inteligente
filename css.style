:root {
  --azul: #2563eb;
  --azul-hover: #1e40af;
  --verde: #16a34a;
  --vermelho: #dc2626;
  --cinza: #6b7280;
  --bg: #f1f5f9;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Segoe UI', sans-serif;
}

body {
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-container {
  background: white;
  padding: 2.5rem;
  border-radius: 16px;
  width: 100%;
  max-width: 420px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  animation: fadeIn 0.6s ease;
}

h2 {
  margin-bottom: 1.5rem;
  text-align: center;
}

.form-group {
  margin-bottom: 1.2rem;
}

label {
  font-size: 0.9rem;
  color: var(--cinza);
}

input {
  width: 100%;
  padding: 0.8rem;
  margin-top: 0.3rem;
  border-radius: 8px;
  border: 2px solid #e5e7eb;
  transition: 0.3s;
}

input:focus {
  border-color: var(--azul);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
}

input.error {
  border-color: var(--vermelho);
  background: #fef2f2;
}

input.success {
  border-color: var(--verde);
  background: #f0fdf4;
}

.error-msg {
  font-size: 0.75rem;
  color: var(--vermelho);
  margin-top: 0.2rem;
}

button {
  width: 100%;
  padding: 1rem;
  margin-top: 1rem;
  background: var(--azul);
  color: white;
  border: none;
  border-radius: 10px;
  font-weight: bold;
  cursor: pointer;
  transition: 0.3s;
}

button:hover {
  background: var(--azul-hover);
}

button:disabled {
  background: #9ca3af;
  cursor: not-allowed;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
